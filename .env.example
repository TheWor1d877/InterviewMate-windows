# InterviewMate 环境变量样例
#
# 用法：复制成 .env 后填入真实值
#   copy .env.example .env
#
# .env 不入 Git（见 .gitignore）。Windows 下可用 icacls 限制访问：
#   icacls .env /inheritance:r /grant:r "%USERNAME%":F
# 环境变量覆盖配置文件里的同名项，见《2-骨架与配置》环境变量一节。

# 必填：模型 API Key，缺失时 start 以退出码 3 结束
MODEL_API_KEY=your_model_api_key

# 可选：覆盖 config/config.yaml 里的 model.base_url 与 model.name
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash

# Dify 检索连接参数：config/config.yaml 的 dify 段只留空值，真实值从这里来
# （启用 RAG 检索时必填；WSL 里部署 Dify 并建好知识库后填入，见部署步骤）
DIFY_BASE_URL=http://your-dify-host/v1
DIFY_DATASET_ID=your_dataset_id
DIFY_DATASET_API_KEY=your_dataset_api_key
